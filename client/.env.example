# Base URL the client's axios instance (src/shared/api) targets for every
# request. Defaults to http://localhost:3000/api when unset.
VITE_API_BASE_URL=http://localhost:3000/api

# This client is not served same-origin with the API (no Vite proxy), so the
# server's CORS_ORIGIN must name the exact origin this client is served from.
# Vite's default dev origin, and the server's default CORS_ORIGIN, are both
# http://localhost:5173. If the client falls back to another port, update the
# server's CORS_ORIGIN (server/.env) to match, or requests will be rejected.
